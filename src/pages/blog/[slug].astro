---
import type { SanityPost } from '@/lib/types'
import PostPage from '@/components/blog/PostPage.astro'
import { fetchSanityData, queries } from '@/lib/services'

export const prerender = false
Astro.response.headers.set(
  'Cache-Control',
  's-maxage=60, stale-while-revalidate=300',
)

const { slug } = Astro.params

const post = await fetchSanityData<SanityPost>(queries.posts.bySlug, {
  slug,
  lang: 'pt',
})

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}
---

<PostPage post={post} />
