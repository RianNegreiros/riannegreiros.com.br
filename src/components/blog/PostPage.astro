---
import { LanguagesIcon } from 'lucide-react'
import type { SanityPost } from '@/lib/types'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LanguageTip from '@/components/blog/slug/LanguageTip'
import PostContent from '@/components/blog/slug/PostContent'
import TableOfContents from '@/components/blog/slug/TableOfContents'
import MobileTableOfContents from '@/components/blog/slug/MobileTableOfContents'
import { formatDate, LOCALES, postPath, postStrings } from '@/lib'
import { urlFor } from '@/lib/services'

interface Props {
  post: SanityPost
}

const { post } = Astro.props
const lang = post.language
const t = postStrings[lang]
const locale = LOCALES[lang]

const absolute = (path: string) => new URL(path, Astro.site).href
const path = postPath(lang, post.slug)
const postUrl = absolute(path)

const otherLang = lang === 'pt' ? 'en' : 'pt'
const translationPath = post.translation
  ? postPath(otherLang, post.translation.slug)
  : null
const ptPath = lang === 'pt' ? path : translationPath
const enPath = lang === 'en' ? path : translationPath
const alternates =
  ptPath && enPath
    ? [
        { hreflang: 'pt-BR', href: absolute(ptPath) },
        { hreflang: 'en', href: absolute(enPath) },
        { hreflang: 'x-default', href: absolute(ptPath) },
      ]
    : []

const ogImage = post.image
  ? urlFor(post.image).width(1200).format('webp').url()
  : '/og-image.png'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.overview ?? '',
  url: postUrl,
  inLanguage: locale.htmlLang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: {
    '@type': 'Person',
    name: 'Rian Negreiros Dos Santos',
    url: 'https://riannegreiros.com.br',
  },
  publisher: {
    '@type': 'Person',
    name: 'Rian Negreiros Dos Santos',
    url: 'https://riannegreiros.com.br',
  },
  ...(post.image && { image: urlFor(post.image).url() }),
  ...(post.firstPublishedDate && { datePublished: post.firstPublishedDate }),
  ...(post.updatedAt && { dateModified: post.updatedAt }),
}
---

<BaseLayout
  title={`${post.title} | Rian Negreiros`}
  description={post.overview ?? 'Blog post by Rian Negreiros'}
  image={ogImage}
  url={postUrl}
  type="article"
  publishedTime={post.firstPublishedDate}
  modifiedTime={post.updatedAt}
  structuredData={structuredData}
  lang={lang}
  alternates={alternates}
>
  <div class="container mx-auto px-4 py-8 sm:py-12">
    <div
      class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12 xl:grid-cols-[1fr_320px]"
    >
      <article class="w-full min-w-0">
        <header class="mb-12">
          <h1 class="mb-4 text-4xl leading-tight font-bold sm:text-5xl">
            {post.title}
          </h1>
          <div
            class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-2 text-sm"
          >
            <time datetime={post.firstPublishedDate}>
              {t.published}
              {formatDate(post.firstPublishedDate, locale.dateLocale)}
            </time>
            {
              translationPath && (
                <a
                  href={translationPath}
                  hreflang={lang === 'pt' ? 'en' : 'pt-BR'}
                  lang={lang === 'pt' ? 'en' : 'pt-BR'}
                  class="text-primary hover:text-primary/80 inline-flex items-center gap-1.5 underline-offset-4 hover:underline"
                >
                  <LanguagesIcon className="h-4 w-4" />
                  {t.switchLanguage}
                </a>
              )
            }
          </div>

          {
            post.image && (
              <figure class="mt-8 overflow-hidden rounded-xl shadow-lg">
                <img
                  loading="eager"
                  fetchpriority="high"
                  src={urlFor(post.image).width(800).format('webp').url()}
                  srcset={`
                  ${urlFor(post.image).width(400).format('webp').url()} 400w,
                  ${urlFor(post.image).width(800).format('webp').url()} 800w,
                  ${urlFor(post.image).width(1200).format('webp').url()} 1200w
                `}
                  sizes="(max-width: 768px) 100vw, 800px"
                  alt={post.image.alt ?? `${t.coverImage} ${post.title}`}
                  class="aspect-video h-auto w-full object-cover"
                  width={800}
                  height={450}
                />
              </figure>
            )
          }
        </header>

        {
          translationPath && (
            <LanguageTip
              pageLang={lang}
              href={translationPath}
              message={postStrings[otherLang].tip.message}
              action={postStrings[otherLang].tip.action}
              dismissLabel={postStrings[otherLang].tip.dismiss}
              client:idle
            />
          )
        }

        <MobileTableOfContents
          headings={post.headings ?? []}
          title={t.toc}
          client:visible
        />

        <PostContent post={post} lang={lang} path={path} client:idle />
      </article>

      <aside class="mt-12 lg:mt-0">
        <div
          class="toc-scroll sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto"
        >
          <TableOfContents
            className="hidden lg:block"
            headings={post.headings ?? []}
            title={t.toc}
            client:visible
          />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
